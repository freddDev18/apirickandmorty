# Include any files or directories that you don't want to be copied to your
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/go/build-context-dockerignore/

**/.classpath
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/.next
**/.cache
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/*.log
**/charts
**/docker-compose*
**/compose*
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
**/build
**/dist
**/tmp
**/temp
LICENSE
README.md

# Ignore IDE specific files
.vscode/
.idea/
*.swp

# Prevent development configuration files from being copied into the container
.devcontainer/

# Ignore CI/CD configuration files
.circleci/
.gitlab-ci.yml

# Ignore template files
templates/
*.template