{
  "name": "js-backend",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "coverage": "vitest run --coverage",
    "start": "node src/index.js",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest --exclude '**/*.e2e.js' --watch=false",
    "test:coverage": "vitest run --coverage --exclude '**/*.e2e.js' --watch=false",
    "e2e": "vitest --exclude '**/*.test.js' --watch=false",
    "e2e:coverage": "vitest run --coverage --exclude '**/*.test.js' --watch=false"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@faker-js/faker": "^8.4.1",
    "@vitest/coverage-v8": "^1.4.0",
    "async_hooks": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.0.2",
    "prettier": "3.2.5",
    "supertest": "^7.0.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "axios": "^1.6.6",
    "dotenv": "^16.3.2",
    "express": "^4.19.2",
    "joi": "^17.12.0",
    "mysql2": "^3.9.7",
    "sequelize": "^6.37.3"
  }
}
