{
    "name": "js-backend",
    "version": "0.0.0",
    "private": true,
    "main": "index.js",
    "scripts": {
        "dev": "nodemon src/index.js",
        "coverage": "vitest run --coverage",
        "start": "node src/index.js",
        "lint": "eslint .",
        "prepare": "husky || true",
        "e2e:run": "NODE_ENV=e2e vitest --exclude '**/*.test.js' --watch=false",
        "e2e:coverage": "NODE_ENV=e2e vitest run --coverage --exclude '**/*.test.js' --watch=false",
        "e2e:wait-db": "bash scripts/wait-for-db.sh db-e2e",
        "e2e:create-containers": "docker compose -f .devcontainer/docker-compose.yml --profile e2e up -d",
        "e2e:remove-containers": "docker compose -f .devcontainer/docker-compose.yml --profile e2e down --volumes",
        "e2e": "npm run e2e:create-containers && npm run e2e:wait-db && npm run e2e:run; npm run e2e:remove-containers",
        "migrations:generate": "npx sequelize-cli migration:generate --name",
        
        "migrations:run": "npx sequelize-cli db:migrate",
        "migrations:revert": "npx sequelize-cli db:migrate:undo",
        "migrations:delete": "npx sequelize-cli db:migrate:undo:all",

        "seeders:generate": "npx sequelize-cli seed:generate --name",
        "seeders:undo": "npx sequelize-cli db:seed:undo",
        "seeders:all": "npx sequelize-cli db:seed:all",

        "db:create": "docker compose -f .devcontainer/docker-compose.yml up -d --build db",
        "db:drop": "docker compose -f .devcontainer/docker-compose.yml down db --volumes",
        "db:up": "npm run migrations:run && npm run seeders:all",
        "db:down": "npm run migrations:delete",
        "db:reset": "npm run db:down; npm run db:drop && npm run db:up"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.3.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@vitest/coverage-v8": "^1.4.0",
        "async_hooks": "^1.0.0",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-prettier": "^5.1.3",
        "husky": "^9.0.11",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.2",
        "msw": "^2.7.3",
        "nodemon": "^3.0.2",
        "prettier": "3.2.5",
        "supertest": "^7.0.0",
        "vitest": "^1.4.0"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "axios": "^1.6.6",
        "dotenv": "^16.3.2",
        "express": "^4.19.2",
        "express-openapi-validator": "^5.4.3",
        "js-yaml": "^4.1.0",
        "pg": "^8.12.0",
        "sequelize": "^6.37.3",
        "umzug": "^3.8.2",
        "mysql2": "^3.9.7",
        "@faker-js/faker": "^8.4.1",
        "sequelize-cli": "^6.6.2"
    }
}
